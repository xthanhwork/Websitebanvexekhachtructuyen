        transition: border-color 0.3s ease, transform 0.3s ease; /* Smooth effect */
        /* Thêm bóng đổ đậm */
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3), 0 16px 32px rgba(0, 0, 0, 0.2); /* Đậm hơn và rõ ràng */
    }

    .flight__onewaysection {
        background-color: #f0f0f0; /* Thay đổi mã màu tùy ý */
    }

    



    /* ===== FIX CUỐI: HEADER KHÔNG CHE NỘI DUNG =====
       Ép header dùng sticky thay vì fixed để nó vẫn bám trên cùng
       nhưng vẫn chiếm chiều cao trong layout. */
    .header-section,
    .header-section.menu-fixed,
    .menu-fixed {
        position: sticky !important;
        top: 0 !important;
        left: auto !important;
        right: auto !important;
        width: 100% !important;
        z-index: 99999 !important;
    }

    .layout-wrapper {
        position: relative;
        z-index: 99999;
    }

    .site-main-content {
        position: relative;
        z-index: 1;
        padding-top: 0 !important;
        margin-top: 0 !important;
        min-height: 60vh;
        background: #fff;
    }

    body {
        padding-top: 0 !important;
    }

</style>


