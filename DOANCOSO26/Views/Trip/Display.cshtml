@model DOANCOSO26.Models.BusTrip
@using DOANCOSO26.Models

@functions {
    private static int SeatOrderValue(string? seatNumber)
    {
        var digits = new string((seatNumber ?? string.Empty).Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var number) ? number : int.MaxValue;
    }
}

@{
    var seatLayout = (Model.Seats ?? new List<DOANCOSO26.Models.Seat>())
        .OrderBy(s => SeatOrderValue(s.SeatNumber))
        .ThenBy(s => s.SeatNumber)
        .ThenBy(s => s.Id)
        .ToList();

    var isSeatCoach = Model.Bus?.BusType == BusType.Standard;
    var layoutName = isSeatCoach ? "Ghế ngồi" : "Giường nằm Limousine";
    var firstFloorSeatCount = isSeatCoach ? seatLayout.Count : (int)Math.Ceiling(seatLayout.Count / 2.0);
    var seatControlWidth = isSeatCoach ? "14%" : "10%";

    var firstFloorSeats = seatLayout.Take(firstFloorSeatCount).ToList();
    var secondFloorSeats = isSeatCoach ? new List<DOANCOSO26.Models.Seat>() : seatLayout.Skip(firstFloorSeatCount).ToList();
}

