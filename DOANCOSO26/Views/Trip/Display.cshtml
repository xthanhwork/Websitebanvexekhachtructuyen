<script>
    document.addEventListener("DOMContentLoaded", () => {
        const imagePaths = [
            '/busjs/assets/img/details/busd1.png',
            '/busjs/assets/img/details/busd4.png',
            '/busjs/assets/img/details/busd3.png',
            '/busjs/assets/img/details/busd2.png',
            '/busjs/assets/img/details/busd2.png',
            '/busjs/assets/img/payment/other-image5.jpg',
            '/busjs/assets/img/payment/other-image6.jpg',
            '/busjs/assets/img/payment/other-image7.jpg',
            '/busjs/assets/img/payment/other-image8.jpg',
            '/busjs/assets/img/payment/other-image9.jpg',
            '/busjs/assets/img/payment/other-image10.jpg',
            '/busjs/assets/img/payment/other-image11.jpg',
            '/busjs/assets/img/payment/other-image12.jpg'
        ];

        let currentStartIndex = 0; // Chỉ số ảnh bắt đầu

        const imageContainer = document.getElementById("imageContainer");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");

        const loadImages = (startIndex) => {
            imageContainer.innerHTML = '';
            const endIndex = Math.min(startIndex + 4, imagePaths.length);

            for (let i = startIndex; i < endIndex; i++) {
                const imgElement = document.createElement("img");
                imgElement.src = imagePaths[i];
                imgElement.alt = `Ảnh ${i + 1}`;
                imgElement.classList.add("thumbnail");
                imgElement.addEventListener("click", () => {
                    showImageViewer(imgElement.src);
                });
                const col = document.createElement("div");
                col.classList.add("col-3", "mb-4");
                col.appendChild(imgElement);
                imageContainer.appendChild(col);
            }

            prevBtn.disabled = currentStartIndex === 0;
            nextBtn.disabled = currentStartIndex + 4 >= imagePaths.length;
        };

        const showImageViewer = (src) => {
            const viewerImage = document.getElementById("viewerImage");
            viewerImage.src = src;
            const imageViewer = document.getElementById("imageViewer");
            imageViewer.style.display = "flex"; // Hiển thị ảnh lớn

            // Cuộn đến vị trí ảnh lớn và căn giữa
            viewerImage.scrollIntoView({
                behavior: "smooth",
                block: "center",
                inline: "center"
            });
        };

        const closeImageViewer = () => {
            document.getElementById("imageViewer").style.display = "none";
        };


        document.getElementById("closeViewer").addEventListener("click", closeImageViewer);
        document.getElementById("imageViewer").addEventListener("click", (e) => {
            if (e.target === document.getElementById("imageViewer")) {
                closeImageViewer();
            }
        });

        // Load ảnh ban đầu
        loadImages(currentStartIndex);

        // Nút mũi tên trước
        prevBtn.addEventListener("click", () => {
            if (currentStartIndex > 0) {
                currentStartIndex -= 4;
                loadImages(currentStartIndex);
            }
        });

        // Nút mũi tên sau
        nextBtn.addEventListener("click", () => {
            if (currentStartIndex + 4 < imagePaths.length) {
                currentStartIndex += 4;
                loadImages(currentStartIndex);
            }
        });
    });

</script>
<script>
    var selectedSeatIds = [];

    function parseSeatPrice(value) {
        if (!value) return 0;
        var cleaned = String(value).replace(/[^0-9.,-]/g, '').replace(/,/g, '');
        var parsed = parseFloat(cleaned);
        return isNaN(parsed) ? 0 : parsed;
    }

    function formatVnd(value) {
        return Math.round(value).toLocaleString('vi-VN');
    }

    function getSelectedSeatButtons() {
        return Array.from(document.querySelectorAll('.time-slot.selected'));
    }

    function updateSelectedSeatSummary() {
        var selectedButtons = getSelectedSeatButtons();
        var names = selectedButtons.map(function (btn) {
            return btn.getAttribute('data-seat-number') || btn.innerText.trim();
        });

        var text = selectedButtons.length
            ? 'Đã chọn ' + selectedButtons.length + ' ghế: ' + names.join(', ')
            : 'Chưa chọn ghế';

        var mainSummary = document.getElementById('selectedSeatSummary');
        if (mainSummary) mainSummary.innerText = text;

        document.querySelectorAll('.selectedSeatSummaryText').forEach(function (el) {
            el.innerText = text;
        });

        var selectedListHtml = !selectedButtons.length
            ? '<li>Chưa có ghế nào được chọn.</li>'
            : names.map(function (name) {
                return '<li><span class="text-dark fw-bold">' + name + '</span></li>';
            }).join('');

        document.querySelectorAll('#selected-seats, .selected-seats-list-js').forEach(function (selectedList) {
            selectedList.innerHTML = selectedListHtml;
        });

        var totalPrice = selectedButtons.reduce(function (sum, btn) {
            return sum + parseSeatPrice(btn.getAttribute('data-price'));
        }, 0);

        document.querySelectorAll('#total-price, .total-price-js').forEach(function (totalPriceEl) {
            totalPriceEl.innerText = formatVnd(totalPrice);
        });

        document.querySelectorAll('#total-amount, .total-amount-js').forEach(function (totalAmountEl) {
            totalAmountEl.innerText = selectedButtons.length;
        });
    }

    function selectSeat(button) {
        var seatId = button.getAttribute('data-seat-id');
        var bookNowBox = document.getElementById('book-now-' + seatId);

        if (button.classList.contains('selected')) {
            button.classList.remove('selected');
            selectedSeatIds = selectedSeatIds.filter(function (id) { return id !== seatId; });
            if (bookNowBox) bookNowBox.style.display = 'none';
        } else {
            button.classList.add('selected');
            if (!selectedSeatIds.includes(seatId)) {
                selectedSeatIds.push(seatId);
            }
            if (bookNowBox) bookNowBox.style.display = 'none';
        }

        updateSelectedSeatSummary();
    }

    function bookNow(seatId) {
        if (seatId && !selectedSeatIds.includes(String(seatId))) {
            selectedSeatIds.push(String(seatId));
        }

        if (!selectedSeatIds.length) {
            alert('Vui lòng chọn ít nhất một ghế trước!');
            return;
        }

        var tripId = '@Model.Id';
        var url = '@Url.Action("Add", "Reservation")?tripId=' + tripId + '&seatIds=' + selectedSeatIds.join(',');
        window.location.href = url;
    }
</script>



