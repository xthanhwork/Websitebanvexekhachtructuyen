@model DOANCOSO26.Models.TripReport
@using DOANCOSO26.Models

@{
    ViewData["Title"] = "Tạo phiếu báo cáo";
    var bookings = ViewBag.Bookings as IEnumerable<Booking> ?? Enumerable.Empty<Booking>();
    var seatInfoByBookingId = ViewBag.SeatInfoByBookingId as Dictionary<int, Seat> ?? new Dictionary<int, Seat>();
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tạo phiếu báo cáo chuyến xe</h2>
            <p class="text-muted mb-0">Cập nhật trạng thái hành khách và chi phí phát sinh của chuyến.</p>
        </div>
        <a asp-action="DisplayDriver" asp-route-id="@Model.BusTripId" class="btn btn-outline-secondary">Quay lại chi tiết chuyến</a>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-2">@Model.BusTrip?.BusRoute?.StartStop?.Name - @Model.BusTrip?.BusRoute?.EndStop?.Name</h5>
            <div class="text-muted">
                <span class="me-3"><strong>Giờ đi:</strong> @Model.BusTrip?.DepartureTime.ToString("HH:mm")</span>
                <span class="me-3"><strong>Ngày đi:</strong> @Model.BusTrip?.DepartureDate.ToString("dd/MM/yyyy")</span>
                <span><strong>Xe:</strong> @Model.BusTrip?.Bus?.BusNumber - @Model.BusTrip?.Bus?.Company</span>
            </div>
        </div>
    </div>

    <form asp-action="CreateReport" asp-route-id="@Model.BusTripId" method="post">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header text-white" style="background:#003366;">
                <h5 class="mb-0">Danh sách hành khách</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Mã vé</th>
                                <th>Họ và tên</th>
                                <th>Số điện thoại</th>
                                <th>Ghế</th>
                                <th>Ghi chú</th>
                                <th class="text-center">Đã lên xe</th>
                                <th class="text-center">Đã đến nơi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!bookings.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chuyến này chưa có vé đặt.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var booking in bookings)
                                {
                                    seatInfoByBookingId.TryGetValue(booking.Id, out var seat);
                                    <tr>
                                        <td>@booking.InvoiceCode</td>
                                        <td>@booking.UserName</td>
                                        <td>@booking.SDT</td>
                                        <td>@(seat?.SeatNumber ?? "N/A")</td>
                                        <td>@booking.Note</td>
                                        <td class="text-center">
                                            <input type="checkbox" name="Bookings[@booking.Id].GotintheBus" value="GotintheBus" @(booking.StatusOnBus == StatusOnBus.GotintheBus || booking.StatusOnBus == StatusOnBus.Arrived ? "checked" : "") />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" name="Bookings[@booking.Id].Arrived" value="Arrived" @(booking.StatusOnBus == StatusOnBus.Arrived ? "checked" : "") />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background:#003366;">
                <h5 class="mb-0">Chi phí và ghi chú</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Gascost" class="form-label">Chi phí xăng</label>
                        <input asp-for="Gascost" class="form-control" type="number" step="1000" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Repaircosts" class="form-label">Chi phí sửa chữa</label>
                        <input asp-for="Repaircosts" class="form-control" type="number" step="1000" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Anothercost" class="form-label">Chi phí khác</label>
                        <input asp-for="Anothercost" class="form-control" type="number" step="1000" min="0" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Note" class="form-label">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control" rows="4" placeholder="Nhập ghi chú chuyến xe..."></textarea>
                    </div>
                    <div class="col-12 text-end">
                        <button class="btn btn-primary px-4" type="submit" onclick="return confirm('Lưu phiếu báo cáo và hoàn tất chuyến xe?');">Lưu phiếu báo cáo</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
